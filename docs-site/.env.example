# Cloudflare Pages deploy credentials, read by wrangler during `npm run deploy`.
# Create a scoped API token (Cloudflare dashboard → My Profile → API Tokens)
# with the "Cloudflare Pages — Edit" permission. Do NOT commit the real token.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Optional: canonical site URL used for sitemap/SEO and canonical links.
# Defaults to the *.pages.dev project URL if unset.
SITE_URL=
