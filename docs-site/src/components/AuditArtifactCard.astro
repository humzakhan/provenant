---
interface Props {
  name: string;
  description: string;
  status?: 'Implemented now' | 'Architecture contract' | 'Planned' | 'Deferred';
}

const { name, description, status = 'Implemented now' } = Astro.props;
---

<article class="artifact-card">
  <div>
    <strong>{name}</strong>
    <span>{status}</span>
  </div>
  <p>{description}</p>
</article>
