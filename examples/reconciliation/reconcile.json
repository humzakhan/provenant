{
  "run": {
    "id": "reconciliation_fixture_run_1",
    "tenant_id": "tenant_demo"
  },
  "files": [
    {
      "id": "bank",
      "purpose": "bank_statement",
      "format": "csv",
      "path": "bank.csv",
      "reader": "extract.csv_rows",
      "selector": {
        "row_window": "2:",
        "encoding": "utf-8",
        "dialect": "excel"
      },
      "columns": {
        "transaction_id": {
          "source": "transaction_id",
          "role": "key",
          "required": true
        },
        "amount": {
          "source": "amount",
          "role": "amount",
          "required": true,
          "numeric": {
            "scale": 2,
            "currency_field": "currency"
          }
        },
        "currency": {
          "source": "currency",
          "role": "currency",
          "required": true
        },
        "description": {
          "source": "description",
          "role": "description"
        }
      }
    },
    {
      "id": "ledger",
      "purpose": "general_ledger",
      "format": "xlsx",
      "path": "ledger.xlsx",
      "reader": "extract.spreadsheet",
      "selector": {
        "sheet": "Ledger",
        "range": "A1:D4",
        "row_window": "2-4"
      },
      "columns": {
        "transaction_id": {
          "source": "A",
          "role": "key",
          "required": true
        },
        "amount": {
          "source": "B",
          "role": "amount",
          "required": true,
          "numeric": {
            "scale": 2,
            "currency_field": "currency"
          }
        },
        "currency": {
          "source": "C",
          "role": "currency",
          "required": true
        },
        "description": {
          "source": "D",
          "role": "description"
        }
      }
    }
  ],
  "reconcile": {
    "mode": "exact_match",
    "left": "bank",
    "right": "ledger",
    "match_on": ["transaction_id"],
    "compare": ["amount", "currency"]
  }
}
