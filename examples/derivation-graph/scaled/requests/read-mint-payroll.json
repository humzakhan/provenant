{
  "run_file": "<path-to-bundle-file>",
  "reader": "extract.csv_rows",
  "source": {
    "source": {
      "path": "fixture://payroll.csv",
      "sha256": "<sha256-of-payroll.csv>"
    },
    "bytes": "<base64-encoded-payroll.csv>"
  },
  "run": {
    "id": "derivation_graph_scaled_run_1",
    "tenant_id": "tenant_demo",
    "status": "running"
  },
  "read": {
    "source_path": "fixture://payroll.csv",
    "selector": {
      "row_window": "<N>-<N>",
      "header_row": 1,
      "dialect": "excel",
      "encoding": "utf-8",
      "column_projection": "salary"
    },
    "output_path": "/rows/0/cells/0/value",
    "unit": "USD"
  }
}
